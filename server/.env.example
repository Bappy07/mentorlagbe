# Server
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/mentorlagbe
DB_NAME=mentorlagbe

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000
# Production (Render): BETTER_AUTH_URL=https://mentorlagbe.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend / CORS (comma separated origins are supported)
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Optional; merged into the same allow-list alongside the values above.
# FRONTEND_URL=
# Production (Render): CLIENT_URL and CORS_ORIGIN=https://mentorlagbe-drab.vercel.app

# JWT used for the protected API middleware
JWT_SECRET=replace-with-another-long-random-secret

# ImgBB image uploads (https://api.imgbb.com/)
IMGBB_API_KEY=

# Manual bKash payments (the current payment router reads BKASH_NUMBER)
# Number shown to students/tutors when they submit a payment.
BKASH_NUMBER=
# Production (Render): set BKASH_NUMBER to the live receiving number.

# Seed account credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@mentorlagbe.com
ADMIN_PASSWORD=Admin@12345
TUTOR_EMAIL=tutor@mentorlagbe.com
TUTOR_PASSWORD=Tutor@12345
STUDENT_EMAIL=student@mentorlagbe.com
STUDENT_PASSWORD=Student@12345
